# Host ports for docker compose services (non-default to avoid clashes)
MONGO_PORT=27018
REDIS_PORT=6380
SMTP_PORT=1026
MAILPIT_UI_PORT=8026

# API configuration
API_PORT=4000
MONGO_URL=mongodb://localhost:27018/pm?directConnection=true
REDIS_URL=redis://localhost:6380
REDIS_PREFIX=pm:
SMTP_HOST=localhost
MAIL_FROM=Projects <no-reply@pm.local>
APP_URL=http://localhost:5173
SESSION_TTL_DAYS=30
AUTH_RATE_LIMIT=20
